# Pick ONE provider (free options: gemini, groq, openrouter, ollama). Default is gemini.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=            (paid; only if LLM_PROVIDER=anthropic)
# LLM_MODEL=                    (optional: overrides the provider's default model)

# Optional: protects /query. If set, callers must send header X-API-Key.
API_KEY=
TOP_K=4
MAX_DISTANCE=0.75
RATE_LIMIT_PER_MIN=20
